  "components": {
    "parameters": {
      "CustomerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Customer ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },

      "CustomerIdForAddress": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "description": "Customer ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },

      "AddressId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Address ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },

      "CustomerIdForService": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "description": "Customer ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      },

      "ServiceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Service ID",
        "schema": {
          "type": "integer",
          "example": 1
        }
      }
    },

    "schemas": {
      "CustomerInput": {
        "type": "object",
        "required": ["customer_name", "phone", "email"],
        "properties": {
          "customer_name": {
            "type": "string",
            "example": "Rahul Sharma"
          },
          "company_name": {
            "type": "string",
            "example": "Rahul Technologies"
          },
          "phone": {
            "type": "string",
            "example": "9876543210"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "rahul@example.com"
          },
          "status": {
            "type": "string",
            "enum": ["Active", "Inactive"],
            "example": "Active"
          }
        }
      },

      "AddressInput": {
        "type": "object",
        "required": [
          "customer_id",
          "address_type",
          "address",
          "city",
          "state",
          "pincode"
        ],
        "properties": {
          "customer_id": {
            "type": "integer",
            "example": 1
          },
          "address_type": {
            "type": "string",
            "example": "Office"
          },
          "address": {
            "type": "string",
            "example": "42, Sector 15"
          },
          "gst_number": {
            "type": "string",
            "example": "24ABCDE1234F1Z5"
          },
          "city": {
            "type": "string",
            "example": "Vadodara"
          },
          "state": {
            "type": "string",
            "example": "Gujarat"
          },
          "pincode": {
            "type": "string",
            "example": "390015"
          },
          "country": {
            "type": "string",
            "example": "India"
          }
        }
      },

      "ServiceInput": {
        "type": "object",
        "required": ["customer_id", "service_type"],
        "properties": {
          "customer_id": {
            "type": "integer",
            "example": 1
          },
          "service_type": {
            "type": "string",
            "example": "Website Development"
          },
          "domain": {
            "type": "string",
            "example": "example.com"
          },
          "renewal_date": {
            "type": "string",
            "format": "date",
            "example": "2027-08-27"
          },
          "duration": {
            "type": "integer",
            "example": 12
          },
          "expiry_date": {
            "type": "string",
            "format": "date",
            "example": "2028-08-27"
          },
          "renewal_amount": {
            "type": "number",
            "format": "double",
            "example": 15000
          },
          "service_status": {
            "type": "string",
            "enum": ["Active", "Inactive", "Expired"],
            "example": "Active"
          }
        }
      }
    }
  }
}
